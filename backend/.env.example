# Copy to .env for local development.
DEBUG=true
SECRET_KEY=change-me
DATABASE_URL=postgres:///axespareparts
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# cloudinary://<api_key>:<api_secret>@<cloud_name>
# Leave empty in development to store uploads on local disk instead.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=axespareparts

# Optional. Without it Celery tasks run inline (no worker needed).
REDIS_URL=

# Brevo SMTP (production). Development prints emails to the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Axe Spare Parts <no-reply@yourdomain>
