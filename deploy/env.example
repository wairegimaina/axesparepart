# Copy to .env in the repo root on the server (never commit it).

# Public hostname. Without a domain yet, use <server-ip-with-dashes>.sslip.io, e.g. 51-68-1-2.sslip.io
SITE_ADDRESS=axespareparts.example

# Must match SITE_ADDRESS.
ALLOWED_HOSTS=axespareparts.example,localhost
FRONTEND_URL=https://axespareparts.example
CSRF_TRUSTED_ORIGINS=https://axespareparts.example
CORS_ALLOWED_ORIGINS=https://axespareparts.example

# Generate with: openssl rand -hex 32   (hex only: it goes into a URL)
POSTGRES_PASSWORD=
# Generate with: openssl rand -base64 48
SECRET_KEY=

# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=axespareparts

# Email (Brevo). SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# or the HTTPS API:
# EMAIL_BACKEND=apps.notifications.brevo.BrevoEmailBackend
# BREVO_API_KEY=
DEFAULT_FROM_EMAIL=Axe Spare Parts <no-reply@axespareparts.example>

# Server size: 2 GB RAM -> GUNICORN_WORKERS=1, PG_SHARED_BUFFERS=128MB; 4 GB+ -> 2 and 256MB.
GUNICORN_WORKERS=1
PG_SHARED_BUFFERS=128MB

# Off-server backup target for rclone (optional), e.g. r2:axe-backups. See deploy/README.md.
BACKUP_REMOTE=
